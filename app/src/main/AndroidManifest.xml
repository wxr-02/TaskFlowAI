<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 调用 LLM API 需要网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 语音输入(长按麦克风说话) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Android 11+ 包可见性:声明需要访问系统语音识别服务,
        否则 speechRecognizer.isRecognitionAvailable 会误报不可用。
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- open_app 工具:枚举启动器应用(Android 11+ 包可见性合规做法) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        工具权限:仅声明,不在代码里动态申请。
        阶段 2 重点演示"权限预检与拦截"——未授予时工具返回 RequiresPermission 状态。
        (SEND_SMS / WRITE_CALENDAR 均为危险权限,必须由用户在运行时授权)
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
        闹钟:系统时钟应用(HandleSetAlarm)受此权限保护(protectionLevel=normal,安装即授予)。
        不加这条会报 "Permission Denial: ... requires com.android.alarm.permission.SET_ALARM"
        —— 真实机型(Huawei EMUI)实测踩过,切勿删除。
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- 精确闹钟:API 31+ 使用 AlarmManager.setAlarmClock 需要(低版本自动忽略) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 闹钟响铃通知/全屏提醒:API 33+ 需要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 锁屏全屏拉起响铃界面(API 34+ 非闹钟类应用可能被降级为横幅,属系统策略) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".TaskFlowApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskFlowAI">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.TaskFlowAI"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TaskFlow 自持闹钟:到点触发的广播接收器 -->
        <receiver
            android:name=".data.alarm.AlarmReceiver"
            android:exported="false" />

        <!-- 闹钟响铃全屏界面(锁屏可亮屏展示) -->
        <activity
            android:name=".ui.alarm.AlarmAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.TaskFlowAI"
            android:turnScreenOn="true" />

        <!--
            WorkManager 集成:使用自定义 HiltWorkerFactory(见 TaskFlowApp),
            移除默认的自动初始化,改由 Application 提供的 Configuration 接管。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>